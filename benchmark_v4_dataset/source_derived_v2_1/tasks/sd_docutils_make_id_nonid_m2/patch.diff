+    # SD:U:U1:begin
+    id = id.replace(',', '-')
+    # SD:U:U1:end
+    # SD:U:U2:begin
+    id = id.replace('!', '-')
+    # SD:U:U2:end
     id = _non_id_at_ends.sub('', id)
