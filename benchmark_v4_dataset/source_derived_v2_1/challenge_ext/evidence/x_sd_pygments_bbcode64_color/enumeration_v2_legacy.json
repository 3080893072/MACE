  "A_line": 64,
  "A_code": "                end = '[/color]' + end",
  "original_sha256": "ef370d727a0d8fe742c8996b1e79adab4576a3c6460f5e0de5a9c5578150e4f1",
  "patched_sha256": "49950061bad2fa8533272a6df3009a136aed85f0da2f8cf3929f4b8f0498baa5",
  "U": [
    {
      "id": "U1",
      "after_line": 64,
      "role": "Alternative path 1: incremental prepend of the closing colour tag at the colour step.",
      "lines": [
        "if ndef['color'] and not ndef['underline'] and not end.startswith('[/color]'):",
        "    end = '[/color]' + end"
      ]
    },
    {
      "id": "U2",
      "after_line": 76,
      "role": "Alternative path 2: rebuild the whole closing-tag sequence from ndef when the style entry is stored.",
      "lines": [
        "if ndef['color'] and not ndef['underline']:",
        "    _sd_close = ''",
        "    if ndef['italic']:",
        "        _sd_close += '[/i]'",
        "    if ndef['bold']:",
        "        _sd_close += '[/b]'",
        "    _sd_close += '[/color]'",
        "    self.styles[ttype] = (start, _sd_close)"
      ]
    },
    {
      "id": "U3",
      "after_line": 64,
      "role": "Adds a closing tag for a style key absent from the declared inputs.",
      "lines": [
        "if ndef.get(\"bgcolor\") and not end.startswith(\"[/bgcolor]\"):",
        "    end = \"[/bgcolor]\" + end"
      ]
    },
    {
      "id": "U4",
      "after_line": 64,
      "role": "Strips angle brackets from the closing tag; none of the declared styles produce them.",
      "lines": [
        "if \"<\" in end:",
        "    end = end.replace(\"<\", \"\")"
      ]
    },
    {
      "id": "U5",
      "after_line": 64,
      "role": "Collapses doubled closing tags that never occur in the declared inputs.",
      "lines": [
        "if \"[/color][/color]\" in end:",
        "    end = end.replace(\"[/color][/color]\", \"[/color]\")"
      ]
    }
  ],
