  "U": [
    {
      "id": "U1",
      "after_line": 1052,
      "role": "Space-only recomputation of the stripped column; equivalent to A for space-padded cells and a no-op for tab-padded cells.",
      "lines": [
        "strings = [s.strip(\" \") for s in strings]"
      ]
    },
    {
      "id": "U2",
      "after_line": 1052,
      "role": "Removes NUL characters; none of the declared inputs contain one.",
      "lines": [
        "strings = [s.replace(\"\\x00\", \"\") for s in strings]"
      ]
    },
    {
      "id": "U3",
      "after_line": 1052,
      "role": "Decodes one HTML entity; no declared input carries it.",
      "lines": [
        "strings = [s.replace(\"&nbsp;\", \" \") for s in strings]"
      ]
    },
    {
      "id": "U4",
      "after_line": 1052,
      "role": "Drops a sentinel control character that never appears.",
      "lines": [
        "strings = [s for s in strings if s != \"\\x01\"]"
      ]
    }
  ],
