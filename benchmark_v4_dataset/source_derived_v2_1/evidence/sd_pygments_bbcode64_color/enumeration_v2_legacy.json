      "after_line": 76,
      "role": "Alternative path 2: rebuild the whole closing-tag sequence from ndef when the style entry is stored.",
      "lines": [
        "if ndef['color'] and not ndef['underline']:",
        "    _sd_close = ''",
        "    if ndef['italic']:",
        "        _sd_close += '[/i]'",
        "    if ndef['bold']:",
        "        _sd_close += '[/b]'",
        "    _sd_close += '[/color]'",
        "    self.styles[ttype] = (start, _sd_close)"
      ]
    }
